{
  "$schema": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/plugin-platform/manifest.schema.json",
  "schema_version": 1,
  "id": "example.douban-chart",
  "name": "豆瓣最新榜单订阅",
  "version": "1.0.0",
  "description": "订阅豆瓣正在上映、一周口碑榜、新片榜和口碑剧集榜，出现新条目时通过宿主通知提醒。",
  "default_locale": "zh-CN",
  "publisher": {
    "name": "Example Publisher",
    "key_id": "ed25519:REPLACED_BY_PACKAGER",
    "url": "https://example.com/plugins"
  },
  "compatibility": {
    "dian115": ">=3.8.51 <5.0.0",
    "plugin_api": "^2.0"
  },
  "runtime": {
    "kind": "wasm",
    "entry": "runtime/plugin.wasm",
    "protocol": "dian115:wasm@1",
    "startup_timeout_ms": 10000,
    "shutdown_timeout_ms": 5000,
    "timeout_ms": 30000,
    "background_timeout_ms": 60000,
    "max_concurrency": 2,
    "restart_policy": "on-failure",
    "memory_mb": 64
  },
  "permissions": {
    "apis": [
      {
        "method": "GET",
        "path": "/api/plugin-runtime/storage/:key",
        "reason": "读取订阅状态和已经推送过的条目"
      },
      {
        "method": "PUT",
        "path": "/api/plugin-runtime/storage/:key",
        "reason": "保存订阅状态和已经推送过的条目"
      },
      {
        "method": "POST",
        "path": "/api/notifications/plugin",
        "reason": "订阅的榜单出现新条目时提醒用户"
      }
    ],
    "network": [
      {
        "origin": "https://m.douban.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "只读拉取豆瓣公开的榜单接口"
      }
    ]
  },
  "ui": {
    "mode": "federation",
    "icon": "frontend/icon.svg",
    "federation": {
      "entry": "frontend/dist/assets/remoteEntry.js",
      "assets_root": "frontend/dist/assets",
      "module": "./AppPage"
    }
  },
  "jobs": [
    {
      "id": "poll",
      "handler": "poll",
      "default_schedule": "0 * * * *",
      "allow_overlap": false
    }
  ],
  "homepage": "https://example.com/plugins/douban-chart",
  "repository": "https://example.com/source/douban-chart",
  "license": "MIT",
  "tags": [
    "douban",
    "subscription"
  ]
}
